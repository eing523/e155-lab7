# Device Configuration
-a "iCE40UP"
-p iCE40UP5K
-t SG48
-sp "High-Performance_1.2V"

# Synthesis Strategy Options
-frequency 200
-optimization_goal Area
-bram_utilization 100
-ramstyle Auto
-romstyle auto
-dsp_utilization 100
-use_dsp 1
-use_carry_chain 1
-carry_chain_length 0
-resource_sharing 1
-propagate_constants 1
-remove_duplicate_regs 1
-max_fanout 1000
-fsm_encoding_style Auto
-fix_gated_clocks 1
-loop_limit 1950
-use_io_reg auto
-drc_cfg 35103300 20
-use_io_insertion 1
-resolve_mixed_drivers 0

# Constraint Files
-sdc "lab7_ei_impl_1_cpe.ldc"

# Search Paths
-path "C:/lscc/radiant/2026.1/ispfpga/ice40tp/data"
-path "."
-path ".."
-path "../../lab07/lab07_fpga/src"
-path "../../lab07/workshop/ex1_state_array"
-path "../../lab07/workshop/ex2_shiftrows"
-path "../../lab07/workshop/ex3_mixcolumns_a"
-path "../../lab07/workshop/stretch_round_trace"
-path "../source/impl_1"

# PMI Library Files
-ver "C:/lscc/radiant/2026.1/ip/pmi/pmi_iCE40UP.v"
-lib pmi -vhd "C:/lscc/radiant/2026.1/ip/pmi/pmi_iCE40UP.vhd"

# Source Files
-sver "../../lab07/lab07_fpga/src/aes_starter.sv"
-sver "../../lab07/workshop/ex2_shiftrows/input_to_state.sv"
-sver "../../lab07/workshop/ex2_shiftrows/shiftrows.sv"
-sver "../../lab07/workshop/ex2_shiftrows/state_to_output.sv"
-sver "../source/impl_1/aes_spi.sv"
-sver "../source/impl_1/aes_core.sv"
-sver "../source/impl_1/mixcolumns.sv"
-sver "../source/impl_1/keyexpansion.sv"
-sver "../source/impl_1/sbox_sync.sv"
-sver "../source/impl_1/addroundkey.sv"
-sver "../source/impl_1/subbytes.sv"
-path ".."
-top aes
# Output Configuration
-udb "lab7_ei_impl_1_rtl.udb"
-output_hdl "lab7_ei_impl_1.vm"
